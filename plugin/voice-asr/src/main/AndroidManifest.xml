<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Model downloads go through DownloadManager, whose provider guards
        content://downloads/my_downloads with android.permission.INTERNET; without
        it enqueue() throws "Permission Denial: writing ... DownloadProvider uri
        content://downloads/my_downloads". POST_NOTIFICATIONS only decides whether
        the download progress notification is visible, never whether it runs.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        The host IME binds this service, so the plugin has to be able to see the
        host package (Android 11+ package visibility). All main-app variants are
        listed because a plugin build against one variant can be installed next to
        another variant of the host.
    -->
    <queries>
        <package android:name="org.fcitx.fcitx5.android" />
        <package android:name="org.fcitx.fcitx5.android.debug" />
        <package android:name="org.fcitx.fcitx5.android.fx" />
        <package android:name="org.fcitx.fcitx5.android.fx.debug" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_plugin_generic"
        android:supportsRtl="true">

        <activity
            android:name=".VoiceAsrSettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/VoiceAsrTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Exported so the IME can find it with queryIntentServices; the caller is
            verified in VoiceInputCallers because an `android:permission` guard
            would only match one host variant (see that file). The fixed actions
            keep a release plugin usable with a debug host and vice versa.
        -->
        <service
            android:name=".VoiceAsrService"
            android:exported="true"
            android:label="@string/service_streaming">
            <intent-filter>
                <action android:name="${mainApplicationId}.plugin.VOICE_INPUT" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.fcitx.fcitx5.android.fx.plugin.VOICE_INPUT" />
                <action android:name="org.fcitx.fcitx5.android.fx.debug.plugin.VOICE_INPUT" />
                <action android:name="org.fcitx.fcitx5.android.plugin.VOICE_INPUT" />
                <action android:name="org.fcitx.fcitx5.android.debug.plugin.VOICE_INPUT" />
            </intent-filter>
        </service>

        <!-- Same action as the streaming provider: the IME lists every service
             that answers it, so the user picks the engine in the voice input
             setting and the two never need host-side changes. -->
        <service
            android:name=".VoiceAsrBatchService"
            android:exported="true"
            android:label="@string/service_batch">
            <intent-filter>
                <action android:name="${mainApplicationId}.plugin.VOICE_INPUT" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.fcitx.fcitx5.android.fx.plugin.VOICE_INPUT" />
                <action android:name="org.fcitx.fcitx5.android.fx.debug.plugin.VOICE_INPUT" />
                <action android:name="org.fcitx.fcitx5.android.plugin.VOICE_INPUT" />
                <action android:name="org.fcitx.fcitx5.android.debug.plugin.VOICE_INPUT" />
            </intent-filter>
        </service>
    </application>
</manifest>
